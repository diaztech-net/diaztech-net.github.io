const CONTACT_EMAIL = "seblackson@diaztech.net";
---
<BaseLayout title="Materials | Diaz Tech Home Page" current="/materials">
  <section class="section">
    <div class="container">
      <h1>Our Materials</h1>
      <h2 style="margin-top:32px;">Explore Your Options through Our Collection</h2>
      <p style="max-width:760px;">
        Diaz Technologies supplies post-consumer and post-industrial recycled polypropylene
        grades, sourced and processed for injection molding and extrusion applications.
      </p>
      <ul class="material-index">
        {materials.map((m) => (
          <li><a href={`#sku-${m.sku}`}>{m.title} <span>SKU {m.sku}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  {materials.map((m) => (
    <section class="material" id={`sku-${m.sku}`}>
      <div class="container">
        <div class="product-detail">
          <Image src={m.image} alt={m.imageAlt} width={Math.min(640, m.image.width)} loading="lazy" class="material-image" />
          <div>
            <p class="section-heading">SKU {m.sku}</p>
            <h2 class="material-title">{m.title}</h2>
            <p class="material-subtitle">{m.subtitle}</p>
            <p>{m.description}</p>
            <h3 class="material-label">Material Profile</h3>
            <dl class="material-profile">
              {m.profile.map(([k, v]) => (
                <div><dt>{k}</dt><dd>{v}</dd></div>
              ))}
            </dl>
          </div>
        </div>

        <details class="spec-details" open>
        <summary>
          <h3 class="material-label">Typical Test Results</h3>
          <span class="spec-toggle-label" aria-hidden="true"></span>
        </summary>
        <div class="spec-table-wrap">
          <table class="spec-table">
            <thead>
              <tr><th scope="col">Property</th><th scope="col" class="spec-method">Test Method</th><th scope="col">Unit</th><th scope="col">Typical Value</th></tr>
            </thead>
            <tbody>
              {m.tests.map(([prop, method, unit, value]) => (
                <tr>
                  <th scope="row">
                    {prop}
                    {method !== "–" && <span class="spec-method-inline">{method}</span>}
                  </th>
                  <td class="spec-method">{method}</td><td>{unit}</td><td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        </details>

        <div class="material-extras">
          <div>
            <h3 class="material-label">Key Features</h3>
            <ul class="material-features">
              {m.features.map((f) => <li>{f}</li>)}
            </ul>
          </div>
          {m.technicalNote && (
            <div>
              <h3 class="material-label">Technical Note</h3>
              <p>{m.technicalNote}</p>
            </div>
          )}
        </div>

        <a
          href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(`Inquiry: ${m.title} (SKU ${m.sku})`)}`}
          class="btn-primary"
        >
          Request Samples or Pricing
        </a>
      </div>
    </section>
  ))}

  <section class="section">
    <div class="container">
      <p class="notice">
        For availability, samples, pricing, or technical assistance, contact Susan Blackson,
        Director of Business Development, at
        <a href={`mailto:${CONTACT_EMAIL}`} style="text-decoration:underline;">{CONTACT_EMAIL}</a>.
      </p>
      <p class="material-disclaimer">
        <strong>Disclaimer:</strong> The data presented herein represents test results obtained
        from laboratory evaluation and is believed to be accurate. Values should not be construed
        as product specifications or warranties of performance. Users are responsible for
        determining suitability for their specific applications, processing conditions, and
        regulatory requirements.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  // Spec tables are collapsible on mobile only; on wider screens they're
  // always expanded and the summary acts as a plain heading.
  const mobile = window.matchMedia("(max-width: 600px)");
  const tables = document.querySelectorAll<HTMLDetailsElement>(".spec-details");

  function sync() {
    tables.forEach((d) => (d.open = !mobile.matches));
  }

  tables.forEach((d) =>
    d.querySelector("summary")!.addEventListener("click", (e) => {
      if (!mobile.matches) e.preventDefault();
    })
  );

  sync();
  mobile.addEventListener("change", sync);
</script>
