---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import superSacksProject from "../../assets/images/blog-super-sacks-project.webp";
---
<BaseLayout
  title="Diaz Technologies New Collaboration with Global Pak on a Super Sacks Project"
  current="/blog"
>
  <section class="section">
    <div class="container" style="max-width:800px;">
      <a href="/blog" style="font-size:14px; color:var(--color-muted);">&larr; All Posts</a>
      <h1>Diaz Technologies New Collaboration with Global Pak on a Super Sacks Project</h1>
      <p class="company">seblackson · Jun 29 · 1 min read</p>
      <Image
        src={superSacksProject}
        alt="Diaz Technologies New Collaboration with Global Pak on a Super Sacks Project"
        width={800}
        loading="eager"
        fetchpriority="high"
        style="border-radius:var(--radius-card); margin:24px 0;"
      />
      <p>If you have any questions about how you can join us today the contact information is above.</p>
      <p class="notice">
        This is the entire published post on the live site — worth expanding with real detail
        about the Global Pak collaboration before/after migration.
      </p>
    </div>
  </section>
</BaseLayout>
