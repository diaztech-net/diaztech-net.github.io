---
import BaseLayout from "../layouts/BaseLayout.astro";

// (Outlook → Calendar → Settings → Bookings with me). Configured availability
const BOOKING_URL = "https://bookings.cloud.microsoft/bookwithme/user/03c19509b9d84cc4836d01b0984c7ec4%40diaztech.net/meetingtype/FDBLQet2bE23ZnJ5VjbSPw2?anonymous";
---
<BaseLayout title="Book Online | Diaz Tech Home Page" current="/book-online">
  <section class="section">
    <div class="container">
      <h1>Book Online</h1>

      {BOOKING_URL ? (
        <iframe
          src={BOOKING_URL}
          title="Book a call"
          style="width:100%; height:800px; border:1px solid var(--color-border); border-radius:var(--radius-card);"
          loading="lazy"
        />
      ) : (
        <>
          <p>Schedule a call — booking calendar coming soon.</p>
        </>
      )}
    </div>
  </section>
</BaseLayout>
