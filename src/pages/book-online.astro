---
import BaseLayout from "../layouts/BaseLayout.astro";

// TODO: replace with Sue's real "Bookings with me" link once she shares it
// (Outlook → Calendar → Settings → Bookings with me). Configured availability
// should match what's live on the Wix site's "Phone call" scheduler: 10 AM–6 PM.
const SUE_BOOKING_URL = "";
---
<BaseLayout title="Book Online | Diaz Tech Home Page" current="/book-online">
  <section class="section">
    <div class="container">
      <h1>Book Online</h1>

      {SUE_BOOKING_URL ? (
        <iframe
          src={SUE_BOOKING_URL}
          title="Book a call with Sue"
          style="width:100%; height:800px; border:1px solid var(--color-border); border-radius:var(--radius-card);"
          loading="lazy"
        />
      ) : (
        <>
          <p>Schedule a call — booking calendar coming soon.</p>
          <p class="notice">
            PLACEHOLDER — replace <code>SUE_BOOKING_URL</code> in this file with Sue's Outlook
            "Bookings with me" link once she shares it, then swap this notice out for the
            &lt;iframe&gt; embed above. Set her availability to 10 AM–6 PM to match what's
            currently live on the Wix site's "Phone call" scheduler.
          </p>
        </>
      )}
    </div>
  </section>
</BaseLayout>
