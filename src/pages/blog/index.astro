---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPosts, formatDate, readTime } from "../../lib/blog";

const posts = await getPosts();
---
<BaseLayout title="Blog | Diaz Tech Home Page" current="/blog">
  <section class="section">
    <div class="container">
      <h1>All Posts</h1>
      <div class="grid grid-3">
        {posts.map((post) => (
          <a href={`/post/${post.slug}`} class="card">
            <Image src={post.data.cover} alt={post.data.coverAlt ?? post.data.title} width={520} loading="eager" />
            <h3>{post.data.title}</h3>
            <p class="company">
              {post.data.author} · {formatDate(post.data.date)} · {readTime(post)}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
